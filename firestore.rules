rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerEmail() {
      return 'svishlk9966@gmail.com';
    }

    function isOwner() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email == ownerEmail();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function taskDoc(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId));
    }

    function isPaidTaskForSelectedFreelancer(taskId, freelancerId) {
      return taskDoc(taskId).exists()
        && taskDoc(taskId).data.paymentStatus == 'paid'
        && (taskDoc(taskId).data.selectedFreelancerId == freelancerId || taskDoc(taskId).data.assignedTo == freelancerId);
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if isOwner() || isSelf(userId);
      allow update: if isOwner() || isSelf(userId);
      allow delete: if isOwner();
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.postedById == request.auth.uid;
      allow update: if isOwner()
        || (signedIn() && resource.data.postedById == request.auth.uid)
        || (signedIn() && resource.data.assignedTo == request.auth.uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bids', 'clientUpdatedAt']));
      allow delete: if isOwner() || (signedIn() && resource.data.postedById == request.auth.uid);
    }

    match /payments/{paymentId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.clientId == request.auth.uid || resource.data.freelancerId == request.auth.uid));
      allow update: if isOwner() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isOwner();
    }

    match /deliveries/{deliveryId} {
      allow create: if signedIn()
        && request.resource.data.freelancerId == request.auth.uid
        && isPaidTaskForSelectedFreelancer(request.resource.data.taskId, request.resource.data.freelancerId);
      allow read: if isOwner() || (signedIn() && (resource.data.freelancerId == request.auth.uid || resource.data.clientId == request.auth.uid));
      allow update, delete: if isOwner();
    }

    match /workspaceEntries/{entryId} {
      allow create: if signedIn() && request.resource.data.createdById == request.auth.uid;
      allow read: if isOwner() || (signedIn() && (resource.data.clientId == request.auth.uid || resource.data.freelancerId == request.auth.uid || resource.data.createdById == request.auth.uid));
      allow update, delete: if isOwner();
    }


    match /refundRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && taskDoc(request.resource.data.taskId).exists()
        && taskDoc(request.resource.data.taskId).data.postedById == request.auth.uid;
      allow read: if isOwner() || (signedIn() && (
        resource.data.clientId == request.auth.uid
        || resource.data.freelancerId == request.auth.uid
      ));
      allow update, delete: if isOwner();
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update: if isOwner() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isOwner();
    }
  }
}
